# Postgres connection string (Railway gives you this)
DATABASE_URL="postgresql://user:password@host:5432/dbname"
# From console.anthropic.com. Leave empty to run in demo mode without AI.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"
# Password for /admin
ADMIN_TOKEN="change-me"
# How similar a question must be to a template (0 to 1) to skip the AI call
FAQ_MATCH_THRESHOLD="0.62"
# Optional: Telegram handoff (phase 2)
TELEGRAM_BOT_TOKEN=""
